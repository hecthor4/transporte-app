  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b>Versi\xF3n 1.5</b>\n\t- Las interfaces scrolleables se renderizan correctamente
    al final de la pantalla.\n\t- Se puede hacer zoom al mapa del metro.\n\t- La
    informaci\xF3n de la aplicaci\xF3n solo es visible en la pantalla principal.\n\n<b>Versi\xF3n
    1.4</b>\n\t- A\xF1adido correspondencias a l\xEDneas de metro.\n\t- Solucionado
    errores visuales y de c\xF3digo.\n\t- Interfaz se renderiza correctamente en
    m\xF3vil\n\n<b>Versi\xF3n 1.3</b>\n\t- A\xF1adido mapa bus (con l\xEDneas y zoom).\n\t-
    A\xF1adido mapa metro.\n\n<b>Versi\xF3n 1.2</b>\n\t- A\xF1adido ajustes de accesibilidad
    a metro.\n\n<b>Versi\xF3n 1.1</b>\n\t- Interfaz de autobuses arreglada.\n\t-
    Bus N203 a\xF1adido.\n\t- Favicon actualizado.\n\t- FPS limitados a 90.\n\n<b>Versi\xF3n
    1.0</b>\n\t- Metro: 12 l\xEDneas con todas sus paradas.\n\t- Bus: l\xEDneas 280,
    282, 284, 285, 341."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
