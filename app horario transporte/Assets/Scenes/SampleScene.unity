  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "<b>Versi\xF3n 1.7</b> (13/05/2026)\n\t- Favoritos con m\xE1ximo de 5 rutas
    guardables.\n\t- Nueva interfaz para ver paradas de buses.\n\t- Arreglos a la
    barra de desplazado en interfaces.\n\n\n<b>Versi\xF3n 1.6</b> (03/05/2026)\n\t-
    Informaci\xF3n sobre la parada de metro seleccionada.\n\t- Tutorial sobre el
    uso de la aplicaci\xF3n.\n\t- Rutas de metro con transbordos (m\xE1ximo 1).\n\n\n<b>Versi\xF3n
    1.5</b> (02/05/2026)\n\t- Interfaces scrolleables se renderizan correctamente.\n\t-
    Zoom al mapa de metro.\n\t- La informaci\xF3n de la app solo es visible en el
    inicio.\n\n\n<b>Versi\xF3n 1.4</b> (12/04/2026)\n\t- A\xF1adido correspondencias
    a l\xEDneas de metro.\n\t- Solucionado errores visuales y de c\xF3digo.\n\t-
    Interfaz se renderiza correctamente en m\xF3vil\n\n\n<b>Versi\xF3n 1.3</b> (12/04/2026)\n\t-
    A\xF1adido mapa bus (con l\xEDneas y zoom).\n\t- A\xF1adido mapa metro.\n\n\n<b>Versi\xF3n
    1.2</b> (12/04/2026)\n\t- A\xF1adido ajustes de accesibilidad a metro.\n\n\n<b>Versi\xF3n
    1.1</b> (10/04/2026)\n\t- Interfaz de autobuses arreglada.\n\t- Bus N203 a\xF1adido.\n\t-
    Favicon actualizado.\n\t- FPS limitados a 90.\n\n\n<b>Versi\xF3n 1.0</b> (9/04/2026)\n\t-
    Metro: 12 l\xEDneas con todas sus paradas.\n\t- Bus: l\xEDneas 280, 282, 284,
    285, 341."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
